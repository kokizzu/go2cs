<Project>

  <!-- The test project shares its directory with the production project, and NuGet writes each
       project's restore artifacts (project.assets.json) under MSBuildProjectExtensionsPath, which
       defaults to obj/ for both. Sharing one path makes the two projects overwrite each other's
       assets: a production project pulled into the test build graph then reads the TEST project's
       assets and appears to reference itself through the test closure — MSB4006, "circular
       dependency involving ResolveProjectReferences". These roots give each project its own. They
       must be set BEFORE Sdk.props, hence the explicit SDK imports rather than the Sdk attribute. -->
  <PropertyGroup>
    <MSBuildProjectExtensionsPath>obj/tests/</MSBuildProjectExtensionsPath>
    <BaseIntermediateOutputPath>obj/tests/</BaseIntermediateOutputPath>
    <BaseOutputPath>bin/tests/</BaseOutputPath>
  </PropertyGroup>

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(TargetFramework)'==''">net9.0</TargetFramework>
    <RootNamespace>go.os</RootNamespace>
    <AssemblyName>os.exec.tests</AssemblyName>
    <Product>go2cs</Product>
    <Description>$(AssemblyName) ($(TargetFramework) - $(Configuration))</Description>
    <AssemblyTitle>$(Description)</AssemblyTitle>
    <Authors>$(Product) Authors</Authors>
    <Company>The $(Authors)</Company>
    <Copyright>Copyright © 2018-2026 $(Company)</Copyright>
    <RepositoryUrl>https://github.com/ritchiecarroll/go2cs</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <ApplicationIcon>go2cs.ico</ApplicationIcon>
    <!-- Same rationale as the production template (csproj-template.xml): `annotations` because Go
         has no non-nullable reference type, and a NoWarn list of the diagnostics that are structural
         to the Go emission model rather than defects. The two lists must stay in step. -->
    <Nullable>annotations</Nullable>
    <NoWarn>CS0162;CS0164;CS0282;CS0660;CS0661;CS1717;CS1718;CS8618;CS8860;CS8974;CS8981;IDE0060;IDE1006;CA2255</NoWarn>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>false</IsPackable>
    <!-- The compile view must be EXACTLY the direct references the test converter computed: a
         transitive project reference that contributes a child `go.<pkg>` namespace (e.g.
         internal/testenv dragging io/fs, namespace go.io) collides with the converter's
         in-namespace `using io = io_package;` alias emission (CS0576) — the alias machinery is
         computed against the direct import closure only. -->
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
  </PropertyGroup>

  <!-- Must defer to the bin/tests/ BaseOutputPath above: build outputs are copied to $(OutDir), so
       an unconditional pin here would put the test host in the PRODUCTION project's bin/. -->
  <PropertyGroup Condition="'$(OutDir)'=='' AND '$(BaseOutputPath)'==''">
    <OutDir>bin/$(Configuration)/$(TargetFramework)/</OutDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(USERPROFILE)'==''">
    <USERPROFILE>$(HOME)</USERPROFILE>
  </PropertyGroup>

  <PropertyGroup Condition="'$(go2csPath)'==''">
    <go2csPath Condition="'$(Configuration)'!='Debug'">$(USERPROFILE)/go2cs/</go2csPath>
    <go2csPath Condition="'$(Configuration)'=='Debug' and '$(SolutionDir)'!=''">$(SolutionDir)</go2csPath>
    <go2csPath Condition="'$(go2csPath)'==''">$(MSBuildThisFileDirectory)../../../</go2csPath>
  </PropertyGroup>

  <!-- Expose output of source generators as local files -->
  <PropertyGroup>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <!-- Explicit compile items only (EnableDefaultCompileItems=false): the production sources are
       recompiled into the test assembly alongside the converted test sources; nothing else in the
       shared directory (Generated/**, *.cs.auto review siblings, the production package_info.cs)
       can leak in because it is never listed. -->
  <ItemGroup>
    <Compile Include="dot_test.cs" />
    <Compile Include="env_test.cs" />
    <Compile Include="exec_test.cs" />
    <Compile Include="exec_windows_test.cs" />
    <Compile Include="go2cs_test_host.cs" />
    <Compile Include="internal_test.cs" />
    <Compile Include="lp_test.cs" />
    <Compile Include="lp_windows_test.cs" />
    <Compile Include="package_info_internal_test.cs" />
    <Compile Include="package_init_external_test.cs" />
    <Compile Include="package_test_info.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="bench_test.go" CopyToOutputDirectory="PreserveNewest" />
    <None Include="dot_test.go" CopyToOutputDirectory="PreserveNewest" />
    <None Include="env_test.go" CopyToOutputDirectory="PreserveNewest" />
    <None Include="example_test.go" CopyToOutputDirectory="PreserveNewest" />
    <None Include="exec.go" CopyToOutputDirectory="PreserveNewest" />
    <None Include="exec_linux_test.go" CopyToOutputDirectory="PreserveNewest" />
    <None Include="exec_other_test.go" CopyToOutputDirectory="PreserveNewest" />
    <None Include="exec_plan9.go" CopyToOutputDirectory="PreserveNewest" />
    <None Include="exec_posix_test.go" CopyToOutputDirectory="PreserveNewest" />
    <None Include="exec_test.go" CopyToOutputDirectory="PreserveNewest" />
    <None Include="exec_unix.go" CopyToOutputDirectory="PreserveNewest" />
    <None Include="exec_unix_test.go" CopyToOutputDirectory="PreserveNewest" />
    <None Include="exec_windows.go" CopyToOutputDirectory="PreserveNewest" />
    <None Include="exec_windows_test.go" CopyToOutputDirectory="PreserveNewest" />
    <None Include="internal_test.go" CopyToOutputDirectory="PreserveNewest" />
    <None Include="lp_linux_test.go" CopyToOutputDirectory="PreserveNewest" />
    <None Include="lp_plan9.go" CopyToOutputDirectory="PreserveNewest" />
    <None Include="lp_test.go" CopyToOutputDirectory="PreserveNewest" />
    <None Include="lp_unix.go" CopyToOutputDirectory="PreserveNewest" />
    <None Include="lp_unix_test.go" CopyToOutputDirectory="PreserveNewest" />
    <None Include="lp_wasm.go" CopyToOutputDirectory="PreserveNewest" />
    <None Include="lp_windows.go" CopyToOutputDirectory="PreserveNewest" />
    <None Include="lp_windows_test.go" CopyToOutputDirectory="PreserveNewest" />
    <None Include="read3.go" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(go2csPath)core/bufio/bufio.csproj" />
    <ProjectReference Include="$(go2csPath)core/bytes/bytes.csproj" />
    <ProjectReference Include="$(go2csPath)core/context/context.csproj" />
    <ProjectReference Include="$(go2csPath)core/errors/errors.csproj" />
    <ProjectReference Include="$(go2csPath)core/flag/flag.csproj" />
    <ProjectReference Include="$(go2csPath)core/fmt/fmt.csproj" />
    <ProjectReference Include="$(go2csPath)core/golib/golib.csproj" />
    <ProjectReference Include="$(go2csPath)core/internal/poll/internal.poll.csproj" />
    <ProjectReference Include="$(go2csPath)core/internal/testenv/internal.testenv.csproj" />
    <ProjectReference Include="$(go2csPath)core/io/fs/io.fs.csproj" />
    <ProjectReference Include="$(go2csPath)core/io/io.csproj" />
    <ProjectReference Include="$(go2csPath)core/log/log.csproj" />
    <ProjectReference Include="$(go2csPath)core/net/http/httptest/net.http.httptest.csproj" />
    <ProjectReference Include="$(go2csPath)core/net/http/net.http.csproj" />
    <ProjectReference Include="$(go2csPath)core/net/net.csproj" />
    <ProjectReference Include="$(go2csPath)core/os/exec/internal/fdtest/os.exec.internal.fdtest.csproj" />
    <ProjectReference Include="$(go2csPath)core/os/os.csproj" />
    <ProjectReference Include="$(go2csPath)core/os/signal/os.signal.csproj" />
    <ProjectReference Include="$(go2csPath)core/path/filepath/path.filepath.csproj" />
    <ProjectReference Include="$(go2csPath)core/reflect/reflect.csproj" />
    <ProjectReference Include="$(go2csPath)core/runtime/debug/runtime.debug.csproj" />
    <ProjectReference Include="$(go2csPath)core/runtime/runtime.csproj" />
    <ProjectReference Include="$(go2csPath)core/slices/slices.csproj" />
    <ProjectReference Include="$(go2csPath)core/strconv/strconv.csproj" />
    <ProjectReference Include="$(go2csPath)core/strings/strings.csproj" />
    <ProjectReference Include="$(go2csPath)core/sync/atomic/sync.atomic.csproj" />
    <ProjectReference Include="$(go2csPath)core/sync/sync.csproj" />
    <ProjectReference Include="$(go2csPath)core/syscall/syscall.csproj" />
    <ProjectReference Include="$(go2csPath)core/testing/testing.csproj" />
    <ProjectReference Include="$(go2csPath)core/time/time.csproj" />
    <ProjectReference Include="os.exec.csproj" />
    <ProjectReference Include="$(go2csPath)gen/go2cs-gen/go2cs-gen.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="All" />
  </ItemGroup>

  <!-- Define Go type aliases -->
  <ItemGroup>
    <Using Include="go.builtin" Static="True" />
    <Using Include="System" />
    <Using Include="System.Numerics" />
    <Using Include="System.Object" Alias="any" />
    <Using Include="System.Byte" Alias="uint8" />
    <Using Include="System.UInt16" Alias="uint16" />
    <Using Include="System.UInt32" Alias="uint32" />
    <Using Include="System.UInt64" Alias="uint64" />
    <Using Include="System.SByte" Alias="int8" />
    <Using Include="System.Int16" Alias="int16" />
    <Using Include="System.Int32" Alias="int32" />
    <Using Include="System.Int64" Alias="int64" />
    <Using Include="System.Single" Alias="float32" />
    <Using Include="System.Double" Alias="float64" />
    <Using Include="System.Numerics.Complex" Alias="complex128" />
    <Using Include="System.Int32" Alias="rune" />
    <Using Include="System.Numerics.BigInteger" Alias="GoBigConst" />
    <Using Include="System.ComponentModel.DescriptionAttribute" Alias="GoTagAttribute" />
    <Using Include="System.Runtime.CompilerServices.ModuleInitializerAttribute" Alias="GoInitAttribute" />
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

</Project>
