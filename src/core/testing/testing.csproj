<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>go</RootNamespace>
    <AssemblyName>testing_package</AssemblyName>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>CS8981;IDE1006</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- `testing` is a HAND-OWNED package (like `unsafe`): the converter never queues it, so this
         project compiles only the files in THIS folder. The subdirectories are ordinary converted
         stdlib packages (testing/fstest, testing/iotest, testing/quick, testing/slogtest,
         testing/internal/testdeps) with their own projects — the SDK's default `**/*.cs` glob would
         otherwise swallow them. -->
    <Compile Remove="**/*.cs" />
    <Compile Include="*.cs" />
    <None Remove="*/**/*" />
  </ItemGroup>

  <ItemGroup>
    <!-- The host stays deliberately LEAN — it is a FIXED reference of every converted test project,
         so whatever it pulls in sits underneath every suite, that package's own included. golib is
         the runtime; `time` is here for exactly one member, testing.T.Deadline, whose Go signature
         returns a real time.Time and which no primitive or golib stand-in can satisfy (see
         testing.cs). Notably ABSENT: fmt — the host formats with its own TestFormat instead. -->
    <ProjectReference Include="..\golib\golib.csproj" />
    <ProjectReference Include="..\time\time.csproj" />
    <ProjectReference Include="..\..\gen\go2cs-gen\go2cs-gen.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="All" />
  </ItemGroup>

</Project>
