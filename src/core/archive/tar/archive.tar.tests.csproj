    <None Include="testdata/gnu-not-utf8.tar" CopyToOutputDirectory="PreserveNewest" />
    <None Include="testdata/gnu-sparse-big.tar" CopyToOutputDirectory="PreserveNewest" />
    <None Include="testdata/gnu-utf8.tar" CopyToOutputDirectory="PreserveNewest" />
    <None Include="testdata/gnu.tar" CopyToOutputDirectory="PreserveNewest" />
    <None Include="testdata/hardlink.tar" CopyToOutputDirectory="PreserveNewest" />
    <None Include="testdata/hdr-only.tar" CopyToOutputDirectory="PreserveNewest" />
    <None Include="testdata/invalid-go17.tar" CopyToOutputDirectory="PreserveNewest" />
    <None Include="testdata/issue10968.tar" CopyToOutputDirectory="PreserveNewest" />
    <None Include="testdata/issue11169.tar" CopyToOutputDirectory="PreserveNewest" />
    <None Include="testdata/issue12435.tar" CopyToOutputDirectory="PreserveNewest" />
    <None Include="testdata/neg-size.tar" CopyToOutputDirectory="PreserveNewest" />
    <None Include="testdata/nil-uid.tar" CopyToOutputDirectory="PreserveNewest" />
    <None Include="testdata/pax-bad-hdr-file.tar" CopyToOutputDirectory="PreserveNewest" />
    <None Include="testdata/pax-bad-hdr-large.tar.bz2" CopyToOutputDirectory="PreserveNewest" />
    <None Include="testdata/pax-bad-mtime-file.tar" CopyToOutputDirectory="PreserveNewest" />
    <None Include="testdata/pax-global-records.tar" CopyToOutputDirectory="PreserveNewest" />
