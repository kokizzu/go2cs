    <None Include="testdata/ustar.tar" CopyToOutputDirectory="PreserveNewest" />
    <None Include="testdata/v7.tar" CopyToOutputDirectory="PreserveNewest" />
    <None Include="testdata/writer-big-long.tar" CopyToOutputDirectory="PreserveNewest" />
