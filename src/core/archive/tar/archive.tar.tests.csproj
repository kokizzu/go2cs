    <None Include="testdata/writer.tar" CopyToOutputDirectory="PreserveNewest" />
    <None Include="testdata/xattrs.tar" CopyToOutputDirectory="PreserveNewest" />
    <None Include="writer.go" CopyToOutputDirectory="PreserveNewest" />
    <None Include="writer_test.go" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(go2csPath)core/bytes/bytes.csproj" />
    <ProjectReference Include="$(go2csPath)core/compress/bzip2/compress.bzip2.csproj" />
    <ProjectReference Include="$(go2csPath)core/crypto/md5/crypto.md5.csproj" />
