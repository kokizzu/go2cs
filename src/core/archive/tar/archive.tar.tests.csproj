    <None Include="testdata/pax-path-hdr.tar" CopyToOutputDirectory="PreserveNewest" />
    <None Include="testdata/pax-pos-size-file.tar" CopyToOutputDirectory="PreserveNewest" />
    <None Include="testdata/pax-records.tar" CopyToOutputDirectory="PreserveNewest" />
    <None Include="testdata/pax-sparse-big.tar" CopyToOutputDirectory="PreserveNewest" />
    <None Include="testdata/pax.tar" CopyToOutputDirectory="PreserveNewest" />
    <None Include="testdata/small.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="testdata/small2.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="testdata/sparse-formats.tar" CopyToOutputDirectory="PreserveNewest" />
