    <None Include="stat_actime1.go" CopyToOutputDirectory="PreserveNewest" />
    <None Include="stat_actime2.go" CopyToOutputDirectory="PreserveNewest" />
    <None Include="stat_unix.go" CopyToOutputDirectory="PreserveNewest" />
    <None Include="strconv.go" CopyToOutputDirectory="PreserveNewest" />
    <None Include="strconv_test.go" CopyToOutputDirectory="PreserveNewest" />
    <None Include="tar_test.go" CopyToOutputDirectory="PreserveNewest" />
    <None Include="testdata/file-and-dir.tar" CopyToOutputDirectory="PreserveNewest" />
    <None Include="testdata/gnu-incremental.tar" CopyToOutputDirectory="PreserveNewest" />
    <None Include="testdata/gnu-long-nul.tar" CopyToOutputDirectory="PreserveNewest" />
